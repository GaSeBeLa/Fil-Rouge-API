# Modele du fichier docker/.env — sans aucun secret, donc versionne.
#
# 1. Copie ce fichier sous le nom ".env", dans ce meme dossier docker/.
# 2. Remplace les deux "change-moi" par TES mots de passe.
# 3. Lance : docker compose up -d
#
# ".env" n'est jamais commite : chacun a le sien, avec ses mots de passe.
# Sans lui, docker compose affiche "variable is not set" et la base refuse
# de demarrer (PostgreSQL n'accepte pas un mot de passe vide).

# Garde ce nom de base : l'API et les scripts s'attendent a celui-ci.
POSTGRES_DB=fil_rouge_immobilier
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-moi

# Facultatif : mot de passe du role en lecture seule fil_rouge_reader
# (LOT12). Laisse vide, le role existe mais ne peut pas se connecter.
# Lu a la creation de la base : apres un changement, docker compose down -v
# puis up -d (efface la base de dev locale).
POSTGRES_READER_PASSWORD=

# MinIO exige au moins 3 caracteres pour l'utilisateur, 8 pour le mot de passe.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-moi-aussi

# Signature des jetons de connexion JWT (ADR-052). Obligatoire : sans elle,
# l'API refuse de demarrer. 32 caracteres au moins ; pour en generer un :
#   openssl rand -hex 32
# (ou : python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=

# Cles d'API, une par programme qui appelle l'API (ADR-028, points 4 a 6).
# Chaque appel montre la sienne dans l'en-tete X-API-Key. L'API lit toutes les
# variables qui commencent par API_KEY_ ; sans aucune, elle refuse de demarrer.
# Une cle de plus = une ligne ici ET une ligne dans docker-compose.yml.
# Generer chaque valeur avec : openssl rand -hex 32
API_KEY_INTERNAL=
API_KEY_APP_BACKEND=

# Mot de passe des 4 comptes de demo (demo-client@example.com, etc.), poses par
#   docker compose exec api python -m src.app.scripts.seed_demo
# 12 caracteres au moins. Vide : le script refuse de semer. Apres un
# changement : docker compose up -d (le conteneur api relit la variable).
DEMO_PASSWORD=

# Airflow (profil "airflow" : docker compose --profile airflow up -d).
# Inutiles pour l'API seule ; vides, Airflow ne demarre pas.
#
# Mot de passe du role "airflow", proprietaire de la base "airflow" (cree par
# init-v3/07). Il entre tel quel dans une URL : hexadecimal SEULEMENT.
#   openssl rand -hex 32
# Lu a la creation de la base ; base existante : voir API/README.md, « Airflow ».
AIRFLOW_DB_PASSWORD=
# Mot de passe du compte "admin" de l'interface http://localhost:8080
AIRFLOW_ADMIN_PASSWORD=
# Cle qui chiffre les mots de passe des connexions Airflow (Fernet) : 32
# octets en base64. Pour en generer une :
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
